<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
<Script file="BuffMaster.lua"/>
<Frame name="BuffMasterFrame" parent="UIParent" frameStrata="LOW" toplevel="true">
<Size>
<AbsDimension x="50" y="50"/>
</Size>
<Anchors>
<Anchor point="TOPRIGHT" relativeTo="BuffFrame" relativePoint="BOTTOMRIGHT">
<Offset>
<AbsDimension x="0" y="0"/>
</Offset>
</Anchor>
</Anchors>
<Scripts>
<OnUpdate>
BuffMaster_UpdateTimers();
</OnUpdate>
</Scripts>
</Frame>
<Frame name="BuffMasterDebuffFrame" parent="UIParent" frameStrata="LOW" toplevel="true">
<Size>
<AbsDimension x="50" y="50"/>
</Size>
<Anchors>
<Anchor point="TOPRIGHT" relativeTo="BuffFrame" relativePoint="BOTTOMRIGHT">
<Offset>
<AbsDimension x="0" y="-100"/>
</Offset>
</Anchor>
</Anchors>
<Scripts>
<OnUpdate>
BuffMaster_UpdateDebuffTimers();
</OnUpdate>
</Scripts>
</Frame>
</Ui>
