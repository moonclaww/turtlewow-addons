<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
<Script file="localization.lua"/>
<Script file="ItemBuff.lua"/>
<CheckButton name="ItemBuffButtonTemplate" hidden="true" virtual="true">
<Size>
<AbsDimension x="36" y="36"/>
</Size>
<Frames>
<Model name="$parentCooldown" inherits="CooldownFrameTemplate"/>
</Frames>
<Layers>
<Layer level="BACKGROUND">
<Texture name="$parentIcon"/>
</Layer>
<Layer level="ARTWORK">
<FontString name="$parentLabel" inherits="GameFontHighlightSmall" >
<Anchors>
<Anchor point="LEFT">
<Offset>
<AbsDimension x="40" y="0"/>
</Offset>
</Anchor>
</Anchors>
</FontString>
<FontString name="$parentDuration" inherits="GameFontHighlightSmall" >
<Anchors>
<Anchor point="TOPLEFT" relativeTo="$parentLabel" relativePoint="BOTTOMLEFT">
<Offset>
<AbsDimension x="0" y="0"/>
</Offset>
</Anchor>
</Anchors>
</FontString>
<FontString name="$parentCharge" inherits="GameFontHighlightSmall">
<Anchors>
<Anchor point="BOTTOMLEFT">
<Offset>
<AbsDimension x="16" y="2"/>
</Offset>
</Anchor>
</Anchors>
<Color r="0" g="1" b="0"/>
</FontString>
</Layer>
</Layers>
<Scripts>
<OnLoad>
ItemBuffButton_OnLoad();
</OnLoad>
<OnEnter>
ItemBuffButton_OnEnter();
</OnEnter>
<OnLeave>
ItemBuffButton_OnLeave();
</OnLeave>
<OnUpdate>
ItemBuffButton_OnUpdate(arg1);
</OnUpdate>
</Scripts>
<NormalTexture name="$parentNormalTexture" file="Interface\Buttons\UI-Quickslot2">
<Size>
<AbsDimension x="64" y="64"/>
</Size>
<Anchors>
<Anchor point="CENTER">
<Offset>
<AbsDimension x="1" y="-1"/>
</Offset>
</Anchor>
</Anchors>
</NormalTexture>
<HighlightTexture alphaMode="ADD" file="Interface\Buttons\ButtonHilight-Square"/>
</CheckButton>
<Frame name="ItemBuffBar" toplevel="true" frameStrata="LOW" enableMouse="true" parent="BuffFrame">
<Size>
<AbsDimension x="50" y="50"/>
</Size>
<Scripts>
<OnLoad>
ItemBuff_OnLoad();
</OnLoad>
<OnShow>
ItemBuffBar_OnShow();
</OnShow>
<OnEvent>
ItemBuffBar_OnEvent(event);
</OnEvent>
</Scripts>
</Frame>
